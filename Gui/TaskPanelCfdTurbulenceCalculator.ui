<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>TaskPanelCfdTurbulenceCalculator</class>
 <widget class="QWidget" name="TaskPanelCfdTurbulenceCalculator">
  <layout class="QVBoxLayout">

   <item><widget class="QGroupBox" name="groupInputs">
    <property name="title"><string>Flow Parameters</string></property>
    <layout class="QFormLayout">
     <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Reference Velocity U (m/s)</string></property></widget></item>
     <item row="0" column="1"><widget class="QDoubleSpinBox" name="if_ReferenceVelocity"><property name="minimum"><double>0.001</double></property><property name="value"><double>1.0</double></property></widget></item>

     <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Characteristic Length L (m)</string></property></widget></item>
     <item row="1" column="1"><widget class="QDoubleSpinBox" name="if_CharacteristicLength"><property name="minimum"><double>0.001</double></property><property name="value"><double>1.0</double></property></widget></item>

     <item row="2" column="0"><widget class="QLabel"><property name="text"><string>Turbulence Intensity I (e.g. 0.05)</string></property></widget></item>
     <item row="2" column="1"><widget class="QDoubleSpinBox" name="if_TurbulenceIntensity"><property name="minimum"><double>0.001</double></property><property name="maximum"><double>1.0</double></property><property name="singleStep"><double>0.01</double></property><property name="value"><double>0.05</double></property></widget></item>

     <item row="3" column="0"><widget class="QLabel"><property name="text"><string>Cμ constant</string></property></widget></item>
     <item row="3" column="1"><widget class="QDoubleSpinBox" name="if_Cmu"><property name="minimum"><double>0.001</double></property><property name="value"><double>0.09</double></property></widget></item>
    </layout>
   </widget></item>

   <item><widget class="QPushButton" name="pb_Calculate"><property name="text"><string>Calculate Turbulence Parameters</string></property></widget></item>

   <item><widget class="QGroupBox" name="groupOutputs">
    <property name="title"><string>Computed Initialisation Values</string></property>
    <layout class="QFormLayout">
     <item row="0" column="0"><widget class="QLabel"><property name="text"><string>k — Turbulent kinetic energy (m²/s²)</string></property></widget></item>
     <item row="0" column="1"><widget class="QLineEdit" name="le_k"><property name="readOnly"><bool>true</bool></property></widget></item>

     <item row="1" column="0"><widget class="QLabel"><property name="text"><string>ε — Dissipation rate (m²/s³) [k-ε models]</string></property></widget></item>
     <item row="1" column="1"><widget class="QLineEdit" name="le_epsilon"><property name="readOnly"><bool>true</bool></property></widget></item>

     <item row="2" column="0"><widget class="QLabel"><property name="text"><string>ω — Specific dissipation (1/s) [k-ω / SST models]</string></property></widget></item>
     <item row="2" column="1"><widget class="QLineEdit" name="le_omega"><property name="readOnly"><bool>true</bool></property></widget></item>
    </layout>
   </widget></item>

   <item><widget class="QPushButton" name="pb_ApplyToCase"><property name="text"><string>Apply to OpenFOAM Case</string></property></widget></item>

  </layout>
 </widget>
</ui>