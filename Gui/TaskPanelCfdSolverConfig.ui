<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>TaskPanelCfdSolverConfig</class>
 <widget class="QWidget" name="TaskPanelCfdSolverConfig">
  <layout class="QVBoxLayout">
   <item>
    <widget class="QGroupBox" name="gbSchemes">
     <property name="title">
      <string>Numerical Schemes (fvSchemes)</string>
     </property>
     <layout class="QFormLayout">
      <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Time scheme</string></property></widget></item>
      <item row="0" column="1"><widget class="QComboBox" name="comboDdtScheme"/></item>
      
      <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Gradient scheme</string></property></widget></item>
      <item row="1" column="1"><widget class="QComboBox" name="comboGradScheme"/></item>
      
      <item row="2" column="0"><widget class="QLabel"><property name="text"><string>Divergence scheme</string></property></widget></item>
      <item row="2" column="1"><widget class="QComboBox" name="comboDivScheme"/></item>
      
      <item row="3" column="0"><widget class="QLabel"><property name="text"><string>Laplacian scheme</string></property></widget></item>
      <item row="3" column="1"><widget class="QComboBox" name="comboLapScheme"/></item>
      
      <item row="4" column="0"><widget class="QLabel"><property name="text"><string>Interpolation scheme</string></property></widget></item>
      <item row="4" column="1"><widget class="QComboBox" name="comboInterpScheme"/></item>
     </layout>
    </widget>
   </item>
   
   <item>
    <widget class="QGroupBox" name="gbSolution">
     <property name="title">
      <string>Solver Settings (fvSolution)</string>
     </property>
     <layout class="QFormLayout">
      <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Pressure solver</string></property></widget></item>
      <item row="0" column="1"><widget class="QComboBox" name="comboPSolver"/></item>
      
      <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Velocity solver</string></property></widget></item>
      <item row="1" column="1"><widget class="QComboBox" name="comboUSolver"/></item>
      
      <item row="2" column="0"><widget class="QLabel"><property name="text"><string>Turbulence solver</string></property></widget></item>
      <item row="2" column="1"><widget class="QComboBox" name="comboTurbSolver"/></item>
      
      <item row="3" column="0"><widget class="QLabel"><property name="text"><string>Pressure tolerance</string></property></widget></item>
      <item row="3" column="1"><widget class="QLineEdit" name="inputPTol"><property name="text"><string>1e-6</string></property></widget></item>
      
      <item row="4" column="0"><widget class="QLabel"><property name="text"><string>Velocity tolerance</string></property></widget></item>
      <item row="4" column="1"><widget class="QLineEdit" name="inputUTol"><property name="text"><string>1e-5</string></property></widget></item>
      
      <item row="5" column="0"><widget class="QLabel"><property name="text"><string>Turbulence tolerance (k, omega, epsilon)</string></property></widget></item>
      <item row="5" column="1"><widget class="QLineEdit" name="inputTurbTol"><property name="text"><string>1e-5</string></property></widget></item>

      <item row="6" column="0"><widget class="QLabel"><property name="text"><string>Relax factor p</string></property></widget></item>
      <item row="6" column="1"><widget class="QDoubleSpinBox" name="spinRelaxP"><property name="maximum"><double>1.0</double></property><property name="singleStep"><double>0.1</double></property><property name="value"><double>0.3</double></property></widget></item>
      
      <item row="7" column="0"><widget class="QLabel"><property name="text"><string>Relax factor U</string></property></widget></item>
      <item row="7" column="1"><widget class="QDoubleSpinBox" name="spinRelaxU"><property name="maximum"><double>1.0</double></property><property name="singleStep"><double>0.1</double></property><property name="value"><double>0.7</double></property></widget></item>
      
      <item row="8" column="0"><widget class="QLabel"><property name="text"><string>Relax factor Turbulence</string></property></widget></item>
      <item row="8" column="1"><widget class="QDoubleSpinBox" name="spinRelaxTurb"><property name="maximum"><double>1.0</double></property><property name="singleStep"><double>0.1</double></property><property name="value"><double>0.7</double></property></widget></item>

      <item row="9" column="0"><widget class="QLabel"><property name="text"><string>Algorithm</string></property></widget></item>
      <item row="9" column="1"><widget class="QComboBox" name="comboAlgorithm"/></item>
      
      <item row="10" column="0"><widget class="QLabel"><property name="text"><string>nCorrectors</string></property></widget></item>
      <item row="10" column="1"><widget class="QSpinBox" name="spinNCorrectors"><property name="value"><number>2</number></property></widget></item>
      
      <item row="11" column="0"><widget class="QLabel"><property name="text"><string>nNonOrthogonalCorrectors</string></property></widget></item>
      <item row="11" column="1"><widget class="QSpinBox" name="spinNNonOrtho"><property name="value"><number>0</number></property></widget></item>
      
      <item row="12" column="0"><widget class="QLabel"><property name="text"><string>Momentum Predictor</string></property></widget></item>
      <item row="12" column="1"><widget class="QCheckBox" name="checkMomentum"><property name="checked"><bool>true</bool></property></widget></item>
     </layout>
    </widget>
   </item>
  </layout>
 </widget>
</ui>